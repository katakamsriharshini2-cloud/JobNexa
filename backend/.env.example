# ========================================================
# JobNexa Backend Environment Configuration
# ========================================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jobnexa?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=jobnexa_super_secure_jwt_secret_token_2026

# JWT Expiration Period
JWT_EXPIRE=7d

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Cloudinary Persistent Cloud Storage for Resumes
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Initial Admin Account Configuration
ADMIN_NAME=JobNexa Administrator
ADMIN_EMAIL=admin@jobnexa.dev
ADMIN_PASSWORD=Admin@123
