# MongoDB Atlas Database Connection URI (Supports MONGO_URL, MONGO_URI, or MONGODB_URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobnexa?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobnexa?retryWrites=true&w=majority

# JWT Token Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Allowed Origin (Production Vercel Domain)
FRONTEND_URL=https://your-jobnexa-frontend.vercel.app

# Email SMTP Credentials (Optional for Email Verification & Reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Environment Setting
NODE_ENV=production
PORT=5000
